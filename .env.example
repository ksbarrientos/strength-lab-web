# Configuración de desarrollo local de Strength Lab
# Copia este archivo como .env y completa los valores reales.

# Seguridad de Django (obligatorio en producción)
SECRET_KEY=

# Modo debug: True en desarrollo, False en producción
DEBUG=True

# Hosts permitidos, separados por coma (ej.: localhost,127.0.0.1,strengthlab.com)
ALLOWED_HOSTS=localhost,127.0.0.1
